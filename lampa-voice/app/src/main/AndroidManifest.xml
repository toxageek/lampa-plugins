<?xml version="1.0" encoding="utf-8"?>
<!--
    package / versionCode / minSdk / targetSdk задаются в app/build.gradle.kts.
    Ручная сборка (build.sh) подставляет их сама.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Только для локального сервера на 127.0.0.1: без этого разрешения нельзя открыть сокет. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Приложение для ТВ, но не требуем ни тача, ни leanback — ставится и на телефон. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+: без явного списка приложение не «видит» Lampa, YouTube и Google. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube.googletv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.tvmusic" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.google.android.katniss" />
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <!-- Экран настроек: иконка в списке приложений ТВ и телефона. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Точка входа голосовой кнопки. ASSIST делает приложение кандидатом на роль
            «ассистента по умолчанию» (назначается через adb, см. README).
            Остальные action — то, что разные прошивки шлют на долгое нажатие поиска/микрофона.
        -->
        <activity
            android:name=".VoiceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/voice_label"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/VoiceTheme">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Держит сервер передачи фразы ~90 секунд, наружу не экспортируется. -->
        <service
            android:name=".HandoffService"
            android:exported="false" />

        <!--
            Перехват кнопки микрофона, если роль ассистента не срабатывает (кнопку держит Google).
            exported + BIND_ACCESSIBILITY_SERVICE: привязаться может только система.
        -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="@string/key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
